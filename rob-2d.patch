+/// Intro cage-bulb dynamic soft shadows use a dedicated 1024Â² D16 map (sometimes 256Â² D32S8).
+static bool IsRobBulbShadowDepth(const ImageInfo& info) {
+    if (!info.props.is_depth || info.num_samples != 1) {
+        return false;
+    }
+    if (info.size.width == 1024 && info.size.height == 1024 &&
+        info.pixel_format == vk::Format::eD16Unorm) {
